NODE_ENV=development

# Postgres local (ver docker-compose.yml) o el gestionado en producción
DATABASE_URL="postgresql://score:score@localhost:5432/score_dev?schema=public"

PORT=3000

# Orígenes permitidos para CORS, separados por coma (dev: diagnostico y panel)
CORS_ORIGINS="http://localhost:3001,http://localhost:3002"

# Auth de apps/panel (JWT)
JWT_SECRET=""
# Vida de cada token: la sesión vence tras este tiempo sin usar el panel.
JWT_EXPIRES_IN="1d"
# Límite absoluto desde el login, aunque se renueve (604800 = 7 días).
JWT_MAX_SESSION_SECONDS=604800

# Token de enlace de apps/diagnostico (secreto distinto al de panel a propósito)
ACCESS_LINK_JWT_SECRET=""
ACCESS_LINK_JWT_EXPIRES_IN="24h"

# Rate limiting básico
THROTTLE_TTL=60000
THROTTLE_LIMIT=100
# Mismo valor en apps/panel: permite que el panel informe la IP real de quien
# inicia sesión. Vacío en desarrollo = todo cuenta por IP de conexión;
# obligatorio en producción (mínimo 32 caracteres).
PANEL_API_SECRET=""

# URL pública de apps/panel, base de los enlaces que salen por correo
# (recuperar contraseña). Vacía en desarrollo = http://localhost:3002;
# obligatoria en producción.
PANEL_URL=""

# Correo transaccional (src/mail). `log` no envía nada: deja el correo en
# el log de la API. `resend` envía de verdad y exige las tres siguientes
# (en producción es obligatorio). Key de Resend de solo envío, una distinta
# por entorno. Sin dominio verificado, el remitente puede ser
# `Music Finance Pro <onboarding@resend.dev>`, que solo entrega al email
# dueño de la cuenta de Resend.
MAIL_DRIVER="log"
RESEND_API_KEY=""
MAIL_FROM=""
MAIL_REPLY_TO=""
# URL pública y absoluta del logo (PNG); vacía = encabezado en texto
MAIL_LOGO_URL=""

# Solo las usa `prisma/seed.ts` para crear el primer usuario ADMIN de
# apps/panel (pnpm prisma db seed) — no se leen en runtime de la API
ADMIN_EMAIL=""
ADMIN_PASSWORD=""
ADMIN_NAME=""
