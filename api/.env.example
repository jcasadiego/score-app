NODE_ENV=development

# Postgres local (ver docker-compose.yml) o el gestionado en producción.
# En producción es obligatorio cifrar la conexión: sslmode=require o más estricto.
DATABASE_URL="postgresql://score:score@localhost:5432/score_dev?schema=public"

PORT=3000

# Orígenes permitidos para CORS, separados por coma. Son los que llaman desde el
# navegador: apps/diagnostico y score-sitio (el panel llama desde su servidor).
# En producción, solo orígenes https exactos.
CORS_ORIGINS="http://localhost:3001,http://localhost:3002"

# Auth de apps/panel (JWT)
JWT_SECRET=""
# Vida de cada token: la sesión vence tras este tiempo sin usar el panel.
JWT_EXPIRES_IN="1d"
# Límite absoluto desde el login, aunque se renueve (604800 = 7 días).
JWT_MAX_SESSION_SECONDS=604800

# Cifra los secretos del segundo factor del panel: 32 bytes en base64
# (openssl rand -base64 32). Distinta por entorno. Perderla obliga a reconfigurar
# el MFA de todos los usuarios.
MFA_ENCRYPTION_KEY=""

# Firma la sesión del cliente final de apps/diagnostico tras canjear su enlace
# (secreto distinto al del panel a propósito, mínimo 32 caracteres).
ACCESS_LINK_JWT_SECRET=""
# Días de vigencia del enlace que recibe el cliente por correo (1 a 90).
ACCESS_LINK_TTL_DAYS=30

# Proxies de confianza delante de la API: el número exacto, 0 si no hay ninguno.
# Vacío = 0 en desarrollo; obligatorio en producción.
TRUST_PROXY_HOPS=""
# Rate limiting básico
THROTTLE_TTL=60000
THROTTLE_LIMIT=100
# Mismo valor en apps/panel: permite que el panel informe la IP real de quien
# inicia sesión. Vacío en desarrollo = todo cuenta por IP de conexión;
# obligatorio en producción (mínimo 32 caracteres).
PANEL_API_SECRET=""
# Igual para apps/diagnostico (mismo valor allá, distinto del del panel): informa
# la IP real del cliente final al canjear o recuperar su enlace. Vacío en
# desarrollo; obligatorio en producción (mínimo 32 caracteres).
DIAGNOSTIC_API_SECRET=""

# URL pública de apps/panel, base de los enlaces que salen por correo
# (recuperar contraseña, avisos al equipo). Vacía en desarrollo = http://localhost:3002;
# obligatoria en producción.
PANEL_URL=""
# URL pública de apps/diagnostico, base del enlace que recibe el cliente final.
# Vacía en desarrollo = http://localhost:3001; obligatoria (https) en producción.
DIAGNOSTIC_URL=""

# Correo transaccional (src/mail). `log` no envía nada: deja el correo en
# el log de la API. `resend` envía de verdad y exige las tres siguientes
# (en producción es obligatorio). Key de Resend de solo envío, una distinta
# por entorno. Sin dominio verificado, el remitente puede ser
# `Music Finance Pro <onboarding@resend.dev>`, que solo entrega al email
# dueño de la cuenta de Resend.
MAIL_DRIVER="log"
RESEND_API_KEY=""
MAIL_FROM=""
MAIL_REPLY_TO=""
# URL pública y absoluta del logo (PNG); vacía = encabezado en texto
MAIL_LOGO_URL=""

# Entorno de despliegue: development, qa o production. Distingue QA de
# producción aunque ambos usen NODE_ENV=production. Hoy solo lo lee el seed, para
# cargar el cuestionario de prueba en development y qa (vacío = según NODE_ENV).
APP_ENV=""

# Solo las usa `prisma/seed.ts` para crear el primer usuario ADMIN de
# apps/panel (pnpm prisma db seed) — no se leen en runtime de la API
ADMIN_EMAIL=""
ADMIN_PASSWORD=""
ADMIN_NAME=""
