NODE_ENV=development

# Postgres local (ver docker-compose.yml) o el gestionado en producción.
# En producción es obligatorio cifrar la conexión: sslmode=require o más estricto.
DATABASE_URL="postgresql://score:score@localhost:5432/score_dev?schema=public"
# Rol de migraciones, dueño del esquema (PF-58). En QA y PROD es obligatorio y
# DATABASE_URL lleva el rol de la API, sin DDL: la API no arranca en producción
# si su rol puede alterar el esquema o la bitácora. Vacía en local y CI: se
# migra con DATABASE_URL. No ponerla en el .env local: los e2e migran sus
# propias bases y la tomarían.
MIGRATION_DATABASE_URL=""

PORT=3000

# Orígenes permitidos para CORS, separados por coma. Son los que llaman desde el
# navegador: apps/diagnostico y score-sitio (el panel llama desde su servidor).
# En producción, solo orígenes https exactos.
CORS_ORIGINS="http://localhost:3001,http://localhost:3002"

# Auth de apps/panel (JWT)
JWT_SECRET=""
# Vida de cada token: la sesión vence tras este tiempo sin usar el panel.
JWT_EXPIRES_IN="1d"
# Límite absoluto desde el login, aunque se renueve (604800 = 7 días).
JWT_MAX_SESSION_SECONDS=604800

# Cifra los secretos del segundo factor del panel: 32 bytes en base64
# (openssl rand -base64 32). Distinta por entorno. Perderla obliga a reconfigurar
# el MFA de todos los usuarios.
MFA_ENCRYPTION_KEY=""

# Firma la sesión del cliente final de apps/diagnostico tras canjear su enlace
# (secreto distinto al del panel a propósito, mínimo 32 caracteres).
ACCESS_LINK_JWT_SECRET=""
# Días de vigencia del enlace que recibe el cliente por correo (1 a 90).
ACCESS_LINK_TTL_DAYS=30
# Días de vigencia del enlace con que el cliente descarga su informe (1 a 90).
REPORT_LINK_TTL_DAYS=30

# Proxies de confianza delante de la API: el número exacto, 0 si no hay ninguno.
# Vacío = 0 en desarrollo; obligatorio en producción.
TRUST_PROXY_HOPS=""
# Rate limiting básico
THROTTLE_TTL=60000
THROTTLE_LIMIT=100
# Dónde viven los contadores del límite (PF-60): `postgres` (por defecto) los
# comparte entre instancias de la API; `memory`, por proceso (los e2e).
THROTTLE_STORAGE="postgres"
# Mismo valor en apps/panel: permite que el panel informe la IP real de quien
# inicia sesión. Vacío en desarrollo = todo cuenta por IP de conexión;
# obligatorio en producción (mínimo 32 caracteres).
PANEL_API_SECRET=""
# Igual para apps/diagnostico (mismo valor allá, distinto del del panel): informa
# la IP real del cliente final al canjear o recuperar su enlace. Vacío en
# desarrollo; obligatorio en producción (mínimo 32 caracteres).
DIAGNOSTIC_API_SECRET=""

# URL pública de apps/panel, base de los enlaces que salen por correo
# (recuperar contraseña, avisos al equipo). Vacía en desarrollo = http://localhost:3002;
# obligatoria en producción.
PANEL_URL=""
# URL pública de apps/diagnostico, base del enlace que recibe el cliente final.
# Vacía en desarrollo = http://localhost:3001; obligatoria (https) en producción.
DIAGNOSTIC_URL=""

# Correo transaccional (src/mail). `log` no envía nada: deja el correo en
# el log de la API. `resend` envía de verdad y exige las tres siguientes
# (en producción es obligatorio). Key de Resend de solo envío, una distinta
# por entorno. Sin dominio verificado, el remitente puede ser
# `Music Finance Pro <onboarding@resend.dev>`, que solo entrega al email
# dueño de la cuenta de Resend.
MAIL_DRIVER="log"
RESEND_API_KEY=""
MAIL_FROM=""
MAIL_REPLY_TO=""
# URL pública y absoluta del logo (PNG); vacía = encabezado en texto
MAIL_LOGO_URL=""

# Contraseñas filtradas (PF-60): `hibp` (por defecto) consulta Pwned Passwords
# con k-anonimato (solo salen 5 caracteres del SHA-1) además de la lista local;
# `local`, solo la lista (los e2e). Si HIBP no responde, vale la lista local.
BREACHED_PASSWORDS_PROVIDER="hibp"

# Entorno de despliegue: development, qa o production. Distingue QA de
# producción aunque ambos usen NODE_ENV=production; obligatorio con
# NODE_ENV=production. El seed carga el cuestionario de prueba en development y
# qa (vacío = según NODE_ENV), y con production no se admite el motor simulado.
APP_ENV=""

# Motor de cálculo (PF-24): disabled o stub (adapter simulado; PF-26 agrega el
# real). Con disabled, los diagnósticos se completan igual y sus cálculos quedan
# pendientes hasta activar el motor y reiniciar la API. Vacío en desarrollo =
# stub; obligatorio con NODE_ENV=production; stub no se admite con
# APP_ENV=production.
SCORING_ENGINE_DRIVER=""

# IA (PF-32): proveedor (disabled, stub o claude) y modelo por defecto, y por uso
# (flags, report) si se quiere otro. stub responde datos de ejemplo, sin costo
# ni API key; no se admite con APP_ENV=production. Vacío en desarrollo = stub;
# AI_PROVIDER es obligatoria con NODE_ENV=production. Modelo vacío =
# claude-opus-5-5.
AI_PROVIDER=""
AI_MODEL=""
AI_FLAGS_PROVIDER=""
AI_FLAGS_MODEL=""
AI_REPORT_PROVIDER=""
AI_REPORT_MODEL=""
# Tiempo máximo por llamada, en milisegundos (1000 a 600000).
AI_TIMEOUT_MS=60000
# Obligatoria si algún uso tiene el proveedor claude. Cuenta a nombre de Music
# Finance Pro; nunca en el repo.
ANTHROPIC_API_KEY=""

# CRM (PF-80): sincronización SCORE → CRM por una bandeja de salida.
# `simulated` no llama a nada externo (los datos no salen de SCORE); el
# proveedor real llega con PF-82. Vacío en desarrollo = simulated; obligatoria
# con NODE_ENV=production.
CRM_PROVIDER=""
# Solo desarrollo y QA: el CRM simulado falla siempre con este código, para
# probar reintentos y el panel (TIMEOUT, RATE_LIMITED, PROVIDER_ERROR,
# INVALID_DATA o AUTH_FAILED). No se admite con APP_ENV=production.
CRM_SIMULATED_FAILURE=""
# Cada cuánto revisa la bandeja, en milisegundos; 0 la apaga (los e2e).
CRM_SYNC_INTERVAL_MS=30000

# Flags (PF-34): una Confianza del motor por debajo de este valor (0 a 1) genera
# un flag de baja confianza. 0.5 mientras la escala real no esté confirmada.
FLAG_LOW_CONFIDENCE_THRESHOLD=0.5

# Solo las usa `prisma/seed.ts` para crear el primer usuario ADMIN de
# apps/panel (pnpm prisma db seed) — no se leen en runtime de la API
ADMIN_EMAIL=""
ADMIN_PASSWORD=""
ADMIN_NAME=""

# Commit desplegado (PF-71). Lo pone Render, no se carga a mano: el workflow
# de despliegue lo usa para confirmar que la versión nueva está arriba. Sin
# ella (local), /health devuelve `commit: null` y Next.js usa su id de build.
# RENDER_GIT_COMMIT=""

# Almacenamiento de objetos (PF-85): audios de voz (P3). `memory` guarda en el
# proceso (desarrollo y tests; no se admite con NODE_ENV=production); `s3`, un
# bucket privado compatible con S3 (Cloudflare R2); `disabled`, nada se guarda.
# Vacío en desarrollo = memory; obligatoria con NODE_ENV=production.
# Un bucket por base: la limpieza de huérfanos (PF-90) borra los objetos que
# esta base no conoce. Nunca apuntar la API local al bucket de QA.
STORAGE_DRIVER=""
# Con s3: https://<account-id>.r2.cloudflarestorage.com, el bucket y una llave
# con permiso solo sobre ese bucket. Nunca en el repo (docs/infra/almacenamiento.md).
STORAGE_S3_ENDPOINT=""
STORAGE_S3_REGION="auto"
STORAGE_S3_BUCKET=""
STORAGE_S3_ACCESS_KEY_ID=""
STORAGE_S3_SECRET_ACCESS_KEY=""
# Vida de las URLs firmadas de lectura, en segundos (30 a 900).
STORAGE_SIGNED_URL_TTL_SECONDS=300

# Transcripción de la voz (PF-88). `disabled` no transcribe (las pendientes
# esperan a que se active un proveedor); `simulated` devuelve un texto fijo sin
# llamadas externas; `openai` solo con la cuenta de MFP, DPA y retención cero.
# Vacío = simulated en desarrollo y disabled con NODE_ENV=production.
TRANSCRIPTION_PROVIDER=""
TRANSCRIPTION_MODEL="gpt-4o-mini-transcribe"
# Tiempo de espera de cada llamada al proveedor (1 s a 5 min).
TRANSCRIPTION_TIMEOUT_MS=120000
# Solo desarrollo y QA: el simulado falla siempre con este código (TIMEOUT,
# RATE_LIMITED, PROVIDER_ERROR, STORAGE_UNAVAILABLE, INVALID_AUDIO o
# AUTH_FAILED). No se admite con APP_ENV=production.
TRANSCRIPTION_SIMULATED_FAILURE=""
# Cada cuánto revisa las pendientes, en milisegundos; 0 lo apaga (los e2e).
TRANSCRIPTION_INTERVAL_MS=30000
# Obligatoria con TRANSCRIPTION_PROVIDER=openai. Nunca en el repo.
OPENAI_API_KEY=""

# Conservación de la voz (PF-90): cada cuánto se borran los audios vencidos (90
# días tras entregar el informe o sin actividad) y los objetos huérfanos, en
# milisegundos. 6 horas por defecto; 0 lo apaga (los e2e).
VOICE_RETENTION_INTERVAL_MS=21600000
