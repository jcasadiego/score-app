NODE_ENV=development

# Postgres local (ver docker-compose.yml) o el gestionado en producción
DATABASE_URL="postgresql://score:score@localhost:5432/score_dev?schema=public"

PORT=3000

# Orígenes permitidos para CORS, separados por coma (dev: diagnostico y panel)
CORS_ORIGINS="http://localhost:3001,http://localhost:3002"

# Auth de apps/panel (JWT)
JWT_SECRET=""
JWT_EXPIRACION="1d"

# Token de enlace de apps/diagnostico (secreto distinto al de panel a propósito)
ENLACE_JWT_SECRET=""
ENLACE_JWT_EXPIRACION="24h"

# Rate limiting básico
THROTTLE_TTL=60000
THROTTLE_LIMIT=100

# Solo las usa `prisma/seed.ts` para crear el primer usuario ADMIN de
# apps/panel (pnpm prisma db seed) — no se leen en runtime de la API
ADMIN_EMAIL=""
ADMIN_PASSWORD=""
ADMIN_NOMBRE=""
