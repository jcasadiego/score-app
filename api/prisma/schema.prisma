// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// Bitácora de auditoría: registra toda acción de escritura hecha a través
/// de la API (requisito duro de P4). El detalle de qué se cambió va en
/// `data`, ya que la forma exacta depende de cada entidad. La relación
/// hacia la entidad afectada es por referencia (`entity` + `entityId`),
/// no una llave foránea, para no acoplar este modelo a las tablas de cada
/// módulo que use el servicio de auditoría.
model AuditLog {
  id        String         @id @default(cuid())
  actorType AuditActorType @map("actor_type")
  actorId   String?        @map("actor_id")
  action    String
  entity    String
  entityId  String?        @map("entity_id")
  data      Json?
  /// Mismo id del encabezado `X-Request-Id` y del log: une los tres al
  /// investigar un incidente. Nulo en eventos sin petición HTTP.
  requestId String?        @map("request_id")
  createdAt DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([entity, entityId])
  @@index([createdAt])
  @@index([requestId])
  @@map("audit_logs")
}

/// Versión de reglas aplicada a un diagnóstico (requisito duro de P4).
/// El contenido de las reglas es configuración, no código — vive en
/// `content` mientras se define la especificación completa del
/// cuestionario y su lógica.
/// Versión de las reglas del motor. A lo sumo una activa (índice único parcial
/// en la migración).
model RuleSetVersion {
  id        String   @id @default(cuid())
  number    Int      @unique @default(autoincrement())
  content   Json
  active    Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  calculations Calculation[]

  @@map("rule_set_versions")
}

/// Matriz de permisos en CLAUDE.md, sección 5.3.
enum UserRole {
  /// Aprobador: puede hacer todo.
  ADMIN
  /// Revisor.
  REVIEWER

  @@map("user_role")
}

/// Tipo de actor que ejecuta una acción auditada: usuario autenticado de
/// `apps/panel`, cliente final de `apps/diagnostico` (vía token de
/// enlace), o el propio sistema cuando no hay actor autenticado (ej. antes
/// de un login).
enum AuditActorType {
  PANEL_USER
  END_CLIENT
  SYSTEM

  @@map("audit_actor_type")
}

/// Placeholder de autenticación para apps/panel. TODO: el modelo real de
/// permisos (roles múltiples, alcance por caso, etc.) es un pendiente
/// explícito del proyecto — este modelo solo existe para que el
/// mecanismo de login JWT tenga contra qué autenticar mientras tanto.
model User {
  id                  String    @id @default(cuid())
  name                String
  email               String    @unique
  passwordHash        String    @map("password_hash")
  /// Nulo mientras la cuenta espera que su dueño defina la contraseña con el
  /// enlace del correo: al crearla o cuando un Aprobador la invalida. Mientras
  /// tanto `passwordHash` es de una contraseña aleatoria que nadie conoce.
  passwordSetAt       DateTime? @default(now()) @map("password_set_at") @db.Timestamptz(3)
  active              Boolean   @default(true)
  /// Sin valor por defecto: el rol siempre se elige de forma explícita.
  role                UserRole
  /// Va en el JWT (`ver`); subirla invalida todas las sesiones abiertas
  /// del usuario. Se sube en cada cambio de contraseña.
  sessionVersion      Int       @default(0) @map("session_version")
  /// Contraseñas o códigos de MFA incorrectos seguidos. Se reinicia al entrar,
  /// al bloquear o al restablecer la contraseña.
  failedLoginAttempts Int       @default(0) @map("failed_login_attempts")
  /// Hasta cuándo se rechaza el login, aunque la contraseña sea correcta.
  lockedUntil         DateTime? @map("locked_until") @db.Timestamptz(3)
  /// Último código de MFA rechazado. Restablecer la contraseña solo levanta el
  /// bloqueo si ya pasó la duración de un bloqueo desde entonces (PF-65).
  lastFailedMfaAt     DateTime? @map("last_failed_mfa_at") @db.Timestamptz(3)
  /// Secreto TOTP cifrado con `MFA_ENCRYPTION_KEY`. Solo sale en una respuesta
  /// una vez, al configurarlo.
  mfaSecret           String?   @map("mfa_secret")
  /// Nulo mientras no se confirme el primer código: el secreto aún no vale.
  mfaEnabledAt        DateTime? @map("mfa_enabled_at") @db.Timestamptz(3)
  /// Último intervalo de 30 s usado: un mismo código no sirve dos veces.
  mfaLastUsedStep     Int?      @map("mfa_last_used_step")
  createdAt           DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  passwordResetTokens PasswordResetToken[]
  sessions            UserSession[]
  recoveryCodes       UserRecoveryCode[]

  createdQuestionnaireVersions   QuestionnaireVersion[]  @relation("QuestionnaireVersionCreatedBy")
  publishedQuestionnaireVersions QuestionnaireVersion[]  @relation("QuestionnaireVersionPublishedBy")
  createdDiagnostics             Diagnostic[]
  issuedAccessLinks              AccessLink[]
  requestedCalculations          Calculation[]
  reviewedFlags                  Flag[]
  assignedReviews                Review[]
  answerCorrections              AnswerCorrection[]
  approvals                      ReviewApproval[]        @relation("ReviewApprovalApprovedBy")
  voidedApprovals                ReviewApproval[]        @relation("ReviewApprovalVoidedBy")
  reviewNotes                    ReviewNote[]
  reportRevisions                ReportSectionRevision[]
  reportApprovals                ReportApproval[]        @relation("ReportApprovalApprovedBy")
  voidedReportApprovals          ReportApproval[]        @relation("ReportApprovalVoidedBy")

  @@map("users")
}

/// Sesión abierta del panel. El JWT la nombra en `sid`: mientras exista la
/// fila el token vale, y cerrar la sesión la borra. Una por usuario (un solo
/// dispositivo): `userId` único lo garantiza también ante logins simultáneos.
/// `expiresAt` es el límite absoluto de la sesión.
model UserSession {
  id        String   @id @default(cuid())
  userId    String   @unique @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime @map("expires_at") @db.Timestamptz(3)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@map("user_sessions")
}

/// Código de un solo uso para entrar sin el autenticador. Se guarda solo el
/// SHA-256: es aleatorio de 80 bits, así que no hace falta un hash lento.
model UserRecoveryCode {
  id        String    @id @default(cuid())
  userId    String    @map("user_id")
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  codeHash  String    @unique @map("code_hash")
  usedAt    DateTime? @map("used_at") @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([userId])
  @@map("user_recovery_codes")
}

/// Enlace de recuperación de contraseña del panel: un solo uso, vence en
/// una hora. Se guarda solo el SHA-256 del token, nunca el token.
model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String    @map("user_id")
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(3)
  usedAt    DateTime? @map("used_at") @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([userId])
  @@map("password_reset_tokens")
}

/// Familia de diagnóstico que el cliente elige en el formulario de
/// precalificación de `score-sitio`. La API no la infiere: llega ya
/// elegida en el payload.
enum DiagnosticFamily {
  PROJECT
  B2B
  PROFESSIONAL
  CATALOG

  @@map("diagnostic_family")
}

/// Estado comercial de un lead, que el equipo cambia a mano desde el panel
/// mientras no hay CRM. Los estados de pago y diagnóstico activado los
/// agrega el módulo de Pagos.
enum LeadStatus {
  NEW
  CONTACTED
  CONVERTED

  @@map("lead_status")
}

/// Lead registrado desde el formulario de precalificación de
/// `score-sitio` (único punto de contacto entre los dos repos, ver
/// CLAUDE.md sección 7). `email` no es único a propósito: la misma
/// persona puede precalificar más de una vez.
model Lead {
  id          String           @id @default(cuid())
  name        String
  email       String
  phone       String?
  family      DiagnosticFamily
  utmSource   String?          @map("utm_source")
  utmMedium   String?          @map("utm_medium")
  utmCampaign String?          @map("utm_campaign")
  status      LeadStatus       @default(NEW)
  createdAt   DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)

  diagnostic Diagnostic?

  @@index([email])
  @@index([createdAt])
  @@map("leads")
}

enum QuestionnaireVersionStatus {
  /// Editable. A lo sumo uno por familia (índice parcial en la migración).
  DRAFT
  /// Inmutable: un trigger rechaza cualquier cambio a la versión, sus
  /// preguntas y sus opciones.
  PUBLISHED

  @@map("questionnaire_version_status")
}

enum QuestionType {
  SINGLE_CHOICE
  MULTIPLE_CHOICE
  FREE_TEXT

  @@map("question_type")
}

/// Versión del cuestionario de una familia. Cada diagnóstico apunta a la versión
/// publicada que respondió, sin copiar sus preguntas (PF-16).
model QuestionnaireVersion {
  id            String                     @id @default(cuid())
  family        DiagnosticFamily
  versionNumber Int                        @map("version_number")
  status        QuestionnaireVersionStatus @default(DRAFT)
  /// Contenido de prueba mientras llega el cuestionario oficial. Nunca existe en
  /// producción (lo carga `prisma/sample-questionnaire.ts`), y un borrador nuevo
  /// no copia sus preguntas.
  isSample      Boolean                    @default(false) @map("is_sample")
  createdById   String                     @map("created_by_id")
  createdBy     User                       @relation("QuestionnaireVersionCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  publishedAt   DateTime?                  @map("published_at") @db.Timestamptz(3)
  publishedById String?                    @map("published_by_id")
  publishedBy   User?                      @relation("QuestionnaireVersionPublishedBy", fields: [publishedById], references: [id], onDelete: Restrict)
  createdAt     DateTime                   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime                   @updatedAt @map("updated_at") @db.Timestamptz(3)

  questions   Question[]
  diagnostics Diagnostic[]

  @@unique([family, versionNumber])
  @@index([createdById])
  @@index([publishedById])
  @@map("questionnaire_versions")
}

/// Pregunta de una versión. `code` es estable entre versiones: identifica la
/// misma pregunta aunque cambie su texto.
model Question {
  id                     String               @id @default(cuid())
  questionnaireVersionId String               @map("questionnaire_version_id")
  /// Borrar una versión no está permitido; borrar una pregunta de un borrador
  /// arrastra sus opciones.
  questionnaireVersion   QuestionnaireVersion @relation(fields: [questionnaireVersionId], references: [id], onDelete: Restrict)
  code                   String               @db.VarChar(64)
  text                   String               @db.VarChar(500)
  type                   QuestionType
  helpText               String?              @map("help_text") @db.VarChar(1000)
  required               Boolean
  /// Solo en `FREE_TEXT`, y ahí obligatorio (CHECK en la migración).
  maxLength              Int?                 @map("max_length")
  position               Int

  options       AnswerOption[]
  answers       Answer[]
  flagQuestions FlagQuestion[]

  @@unique([questionnaireVersionId, code])
  /// Para la FK compuesta de las respuestas (PF-16): una respuesta solo puede
  /// ser de una pregunta de la versión de su diagnóstico.
  @@unique([id, questionnaireVersionId])
  @@map("questions")
}

/// Opción de una pregunta de selección. `value` es estable entre versiones.
model AnswerOption {
  id         String   @id @default(cuid())
  questionId String   @map("question_id")
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  text       String   @db.VarChar(300)
  value      String   @db.VarChar(64)
  position   Int

  selections AnswerSelection[]

  correctionSelections AnswerCorrectionSelection[]

  @@unique([questionId, value])
  /// Para la FK compuesta de las respuestas (PF-16): una respuesta solo puede
  /// elegir opciones de su propia pregunta.
  @@unique([id, questionId])
  @@map("answer_options")
}

/// Estado guardado del diagnóstico. "Abandonado" no se guarda: es cualquier
/// diagnóstico sin completar con `lastActivityAt` de hace más de 7 días.
enum DiagnosticStatus {
  /// Creado, sin respuestas todavía.
  ACTIVE
  IN_PROGRESS
  /// Enviado por el cliente: ya no admite cambios suyos.
  COMPLETED

  @@map("diagnostic_status")
}

enum AccessLinkOrigin {
  /// Emitido desde el panel, al generar el diagnóstico o al reenviar el enlace.
  PANEL
  /// Pedido por el propio cliente con su correo.
  RECOVERY

  @@map("access_link_origin")
}

enum ExternalPlatform {
  SPOTIFY
  YOUTUBE
  INSTAGRAM
  TIKTOK
  WEBSITE

  @@map("external_platform")
}

/// Diagnóstico de un lead (PF-16). Apunta a la versión publicada del
/// cuestionario que responde: la familia sale de ella, no se repite aquí.
model Diagnostic {
  id                     String               @id @default(cuid())
  /// Único: un diagnóstico por lead.
  leadId                 String               @unique @map("lead_id")
  lead                   Lead                 @relation(fields: [leadId], references: [id], onDelete: Restrict)
  questionnaireVersionId String               @map("questionnaire_version_id")
  questionnaireVersion   QuestionnaireVersion @relation(fields: [questionnaireVersionId], references: [id], onDelete: Restrict)
  status                 DiagnosticStatus     @default(ACTIVE)
  /// Quién lo generó desde el panel. Nulo cuando lo cree el módulo de Pagos.
  createdById            String?              @map("created_by_id")
  createdBy              User?                @relation(fields: [createdById], references: [id], onDelete: Restrict)
  /// Motivo de generarlo sin pago (CLAUDE.md 5.3). Obligatorio si lo generó el
  /// panel (CHECK en la migración).
  creationReason         String?              @map("creation_reason") @db.VarChar(500)
  /// Última escritura del cliente. Base del abandono.
  lastActivityAt         DateTime             @default(now()) @map("last_activity_at") @db.Timestamptz(3)
  completedAt            DateTime?            @map("completed_at") @db.Timestamptz(3)
  createdAt              DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt              DateTime             @updatedAt @map("updated_at") @db.Timestamptz(3)

  accessLinks   AccessLink[]
  answers       Answer[]
  externalLinks ExternalLink[]
  calculations  Calculation[]
  review        Review?

  /// Para la FK compuesta de las respuestas.
  @@unique([id, questionnaireVersionId])
  @@index([questionnaireVersionId])
  @@index([createdById])
  @@index([status, lastActivityAt])
  @@map("diagnostics")
}

/// Enlace sin contraseña del cliente final. Se guarda solo el SHA-256 del token.
/// Sirve varias veces hasta vencer o ser revocado; su uso abre una sesión que
/// vuelve a comprobar el enlace en cada petición.
model AccessLink {
  id           String           @id @default(cuid())
  diagnosticId String           @map("diagnostic_id")
  diagnostic   Diagnostic       @relation(fields: [diagnosticId], references: [id], onDelete: Restrict)
  tokenHash    String           @unique @map("token_hash")
  origin       AccessLinkOrigin
  /// Quién lo emitió desde el panel; nulo en una recuperación.
  createdById  String?          @map("created_by_id")
  createdBy    User?            @relation(fields: [createdById], references: [id], onDelete: Restrict)
  expiresAt    DateTime         @map("expires_at") @db.Timestamptz(3)
  /// Primer canje: un enlace sin usar no corta los anteriores.
  redeemedAt   DateTime?        @map("redeemed_at") @db.Timestamptz(3)
  revokedAt    DateTime?        @map("revoked_at") @db.Timestamptz(3)
  createdAt    DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([diagnosticId])
  @@index([createdById])
  @@index([origin, createdAt])
  @@map("access_links")
}

/// Respuesta del cliente a una pregunta. Las FK compuestas garantizan que la
/// pregunta sea de la versión del diagnóstico. Texto libre en `textValue`; las
/// opciones elegidas, en `AnswerSelection`.
model Answer {
  id                     String     @id @default(cuid())
  diagnosticId           String     @map("diagnostic_id")
  questionnaireVersionId String     @map("questionnaire_version_id")
  questionId             String     @map("question_id")
  diagnostic             Diagnostic @relation(fields: [diagnosticId, questionnaireVersionId], references: [id, questionnaireVersionId], onDelete: Restrict)
  question               Question   @relation(fields: [questionId, questionnaireVersionId], references: [id, questionnaireVersionId], onDelete: Restrict)
  /// Tope absoluto de la base; el de cada pregunta lo valida la API.
  textValue              String?    @map("text_value") @db.VarChar(5000)
  createdAt              DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt              DateTime   @updatedAt @map("updated_at") @db.Timestamptz(3)

  selections  AnswerSelection[]
  corrections AnswerCorrection[]

  @@unique([diagnosticId, questionId])
  /// Para la FK compuesta de las selecciones.
  @@unique([id, questionId])
  @@index([diagnosticId, questionnaireVersionId])
  @@index([questionId, questionnaireVersionId])
  @@map("answers")
}

/// Opción elegida en una respuesta de selección. La FK compuesta garantiza que
/// la opción sea de la misma pregunta que la respuesta.
model AnswerSelection {
  answerId   String       @map("answer_id")
  questionId String       @map("question_id")
  optionId   String       @map("option_id")
  answer     Answer       @relation(fields: [answerId, questionId], references: [id, questionId], onDelete: Cascade)
  option     AnswerOption @relation(fields: [optionId, questionId], references: [id, questionId], onDelete: Restrict)

  @@id([answerId, optionId])
  @@index([answerId, questionId])
  @@index([optionId, questionId])
  @@map("answer_selections")
}

/// Perfil público del cliente en una plataforma: uno por plataforma, solo https.
model ExternalLink {
  id           String           @id @default(cuid())
  diagnosticId String           @map("diagnostic_id")
  diagnostic   Diagnostic       @relation(fields: [diagnosticId], references: [id], onDelete: Restrict)
  platform     ExternalPlatform
  url          String           @db.VarChar(2048)
  createdAt    DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@unique([diagnosticId, platform])
  @@map("external_links")
}

/// Estado de un cálculo del motor (PF-24).
enum CalculationStatus {
  PENDING
  RUNNING
  SUCCEEDED
  FAILED

  @@map("calculation_status")
}

/// Un cálculo del motor para un diagnóstico completado. Nunca se sobrescribe:
/// recalcular crea otro. El último intento es el más reciente; el cálculo
/// vigente, el más reciente `SUCCEEDED`. A lo sumo uno `PENDING` o `RUNNING`
/// por diagnóstico (índice único parcial en la migración).
model Calculation {
  id                 String            @id @default(cuid())
  diagnosticId       String            @map("diagnostic_id")
  diagnostic         Diagnostic        @relation(fields: [diagnosticId], references: [id], onDelete: Restrict)
  status             CalculationStatus @default(PENDING)
  /// Lo que se envía al motor: familia y respuestas por `code` y `value`. En
  /// `jsonb` porque el formato del motor real no está confirmado (PF-26).
  input              Json
  /// Lo que devolvió el motor. Nulo hasta terminar con éxito.
  output             Json?
  /// Versión de reglas que aplicó el motor. Nula hasta tener resultado.
  ruleSetVersionId   String?           @map("rule_set_version_id")
  ruleSetVersion     RuleSetVersion?   @relation(fields: [ruleSetVersionId], references: [id], onDelete: Restrict)
  /// Motor que lo procesó (`stub`, o el real de PF-26).
  engine             String?           @db.VarChar(32)
  /// Resultado del adapter simulado: nunca es un resultado real.
  isSimulated        Boolean?          @map("is_simulated")
  /// Mensaje para el panel si falló, sin detalles internos del motor.
  error              String?           @db.VarChar(500)
  /// Quién lo pidió desde el panel. Nulo si se disparó al completar el diagnóstico.
  requestedById      String?           @map("requested_by_id")
  requestedBy        User?             @relation(fields: [requestedById], references: [id], onDelete: Restrict)
  /// Número de la última corrección del revisor que entró en `input` (PF-39);
  /// 0 si no había ninguna. Así se sabe si el cálculo refleja la última.
  correctionSequence Int               @default(0) @map("correction_sequence")
  flagAnalysis       FlagAnalysis?
  approvals          ReviewApproval[]
  flags              Flag[]
  startedAt          DateTime?         @map("started_at") @db.Timestamptz(3)
  finishedAt         DateTime?         @map("finished_at") @db.Timestamptz(3)
  createdAt          DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([diagnosticId, createdAt])
  @@index([ruleSetVersionId])
  @@index([requestedById])
  @@index([status])
  @@map("calculations")
}

/// Resultado de una llamada a la IA (PF-32).
enum AiCallOutcome {
  SUCCEEDED
  FAILED

  @@map("ai_call_outcome")
}

/// Una llamada a un proveedor de IA. Solo metadatos: nunca el prompt con
/// respuestas del cliente ni la salida. Sirve para conocer el costo real por
/// diagnóstico. `entity`/`entityId` nombran sobre qué se pidió (por ejemplo,
/// `Diagnostic` y su id), por referencia y sin llave foránea, como la bitácora.
model AiCallLog {
  id               String        @id @default(cuid())
  /// Para qué se usó (`flags`, `report`).
  use              String        @db.VarChar(32)
  provider         String        @db.VarChar(32)
  /// Modelo pedido, y el que respondió si el proveedor usó otro (fallback).
  model            String        @db.VarChar(64)
  servedModel      String?       @map("served_model") @db.VarChar(64)
  promptId         String        @map("prompt_id") @db.VarChar(64)
  promptVersion    String        @map("prompt_version") @db.VarChar(16)
  outcome          AiCallOutcome
  /// Motivo de un fallo (`timeout`, `rate_limited`, `invalid_output`...).
  failureReason    String?       @map("failure_reason") @db.VarChar(32)
  inputTokens      Int?          @map("input_tokens")
  outputTokens     Int?          @map("output_tokens")
  /// Aproximado, con la tabla de precios de `src/ai/pricing.ts`. Nulo si el
  /// modelo no tiene precio conocido.
  estimatedCostUsd Decimal?      @map("estimated_cost_usd") @db.Decimal(12, 6)
  durationMs       Int           @map("duration_ms")
  entity           String?       @db.VarChar(64)
  entityId         String?       @map("entity_id") @db.VarChar(64)
  createdAt        DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)

  reportRevisions ReportSectionRevision[]

  @@index([createdAt])
  @@index([entity, entityId])
  @@map("ai_call_logs")
}

/// Origen de un flag (PF-34).
enum FlagSource {
  /// Regla sobre la salida del motor (baja confianza).
  ENGINE
  /// Posible contradicción señalada por la IA.
  AI

  @@map("flag_source")
}

enum FlagSeverity {
  HIGH
  MEDIUM
  LOW

  @@map("flag_severity")
}

enum FlagStatus {
  OPEN
  REVIEWED
  DISMISSED

  @@map("flag_status")
}

enum FlagAnalysisStatus {
  PENDING
  RUNNING
  SUCCEEDED
  FAILED

  @@map("flag_analysis_status")
}

/// Análisis con IA de un cálculo exitoso (PF-34). Uno por cálculo. Cero flags
/// solo significa "sin alertas" si el análisis terminó `SUCCEEDED`.
model FlagAnalysis {
  id            String             @id @default(cuid())
  calculationId String             @unique @map("calculation_id")
  calculation   Calculation        @relation(fields: [calculationId], references: [id], onDelete: Restrict)
  status        FlagAnalysisStatus @default(PENDING)
  /// Con qué se hizo: quedan al terminar, con éxito o no.
  provider      String?            @db.VarChar(32)
  model         String?            @db.VarChar(64)
  promptId      String?            @map("prompt_id") @db.VarChar(64)
  promptVersion String?            @map("prompt_version") @db.VarChar(16)
  isSimulated   Boolean?           @map("is_simulated")
  /// Motivo de un fallo (`timeout`, `invalid_output`, `invalid_question`...).
  failureReason String?            @map("failure_reason") @db.VarChar(32)
  startedAt     DateTime?          @map("started_at") @db.Timestamptz(3)
  finishedAt    DateTime?          @map("finished_at") @db.Timestamptz(3)
  createdAt     DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime           @updatedAt @map("updated_at") @db.Timestamptz(3)

  flags Flag[]

  @@index([status])
  @@map("flag_analyses")
}

/// Alerta para el revisor sobre un cálculo. Nunca cambia el resultado ni las
/// respuestas. Las de IA son siempre "posible contradicción".
model Flag {
  id            String        @id @default(cuid())
  calculationId String        @map("calculation_id")
  calculation   Calculation   @relation(fields: [calculationId], references: [id], onDelete: Restrict)
  /// El análisis que lo generó (solo los de IA).
  analysisId    String?       @map("analysis_id")
  analysis      FlagAnalysis? @relation(fields: [analysisId], references: [id], onDelete: Restrict)
  source        FlagSource
  severity      FlagSeverity
  message       String        @db.VarChar(1000)
  status        FlagStatus    @default(OPEN)
  /// Nota del revisor; obligatoria al descartar (CHECK en la migración).
  reviewNote    String?       @map("review_note") @db.VarChar(1000)
  reviewedById  String?       @map("reviewed_by_id")
  reviewedBy    User?         @relation(fields: [reviewedById], references: [id], onDelete: Restrict)
  reviewedAt    DateTime?     @map("reviewed_at") @db.Timestamptz(3)
  createdAt     DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)

  questions FlagQuestion[]

  @@index([calculationId, status])
  @@index([analysisId])
  @@index([reviewedById])
  @@map("flags")
}

/// Preguntas involucradas en un flag (tabla puente).
model FlagQuestion {
  flagId     String   @map("flag_id")
  flag       Flag     @relation(fields: [flagId], references: [id], onDelete: Restrict)
  questionId String   @map("question_id")
  question   Question @relation(fields: [questionId], references: [id], onDelete: Restrict)

  @@id([flagId, questionId])
  @@index([questionId])
  @@map("flag_questions")
}

/// Estado de la revisión de un diagnóstico (PF-39). Se guarda junto con lo
/// que lo determina: `APPROVED` si hay una aprobación vigente; si no,
/// `IN_REVIEW` si alguien tomó el caso y `PENDING` si nadie.
enum ReviewStatus {
  PENDING
  IN_REVIEW
  APPROVED

  @@map("review_status")
}

/// Por qué dejó de valer una aprobación.
enum ApprovalVoidCause {
  /// Un Aprobador la reabrió, con motivo.
  REOPENED
  /// Se pidió otro cálculo después de aprobar.
  RECALCULATED

  @@map("approval_void_cause")
}

/// Revisión humana de un diagnóstico (el "caso" de la pantalla). Se crea con
/// su primer cálculo. `version` sube con cada cambio que importa a quien
/// corrige o aprueba (ETag/If-Match).
model Review {
  id           String       @id @default(cuid())
  diagnosticId String       @unique @map("diagnostic_id")
  diagnostic   Diagnostic   @relation(fields: [diagnosticId], references: [id], onDelete: Restrict)
  status       ReviewStatus @default(PENDING)
  /// Quién tiene tomado el caso. Solo esa persona corrige.
  assigneeId   String?      @map("assignee_id")
  assignee     User?        @relation(fields: [assigneeId], references: [id], onDelete: Restrict)
  assignedAt   DateTime?    @map("assigned_at") @db.Timestamptz(3)
  version      Int          @default(0)
  createdAt    DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)

  corrections AnswerCorrection[]
  approvals   ReviewApproval[]
  notes       ReviewNote[]
  report      Report?

  @@index([assigneeId])
  @@index([status, createdAt])
  @@map("reviews")
}

/// Corrección del revisor a una respuesta del cliente. De solo inserción: la
/// respuesta original y las correcciones anteriores nunca se pierden. La
/// respuesta efectiva es la de mayor `sequence` para esa respuesta, o la
/// original. Mismo formato que `Answer`: texto en `textValue`, opciones en
/// `AnswerCorrectionSelection`.
model AnswerCorrection {
  id            String   @id @default(cuid())
  reviewId      String   @map("review_id")
  review        Review   @relation(fields: [reviewId], references: [id], onDelete: Restrict)
  /// Orden dentro de la revisión (1, 2, 3...), asignado con la revisión
  /// bloqueada: no depende de relojes.
  sequence      Int
  answerId      String   @map("answer_id")
  questionId    String   @map("question_id")
  /// La FK compuesta garantiza que `questionId` sea el de la respuesta.
  answer        Answer   @relation(fields: [answerId, questionId], references: [id, questionId], onDelete: Restrict)
  textValue     String?  @map("text_value") @db.VarChar(5000)
  reason        String   @db.VarChar(500)
  correctedById String   @map("corrected_by_id")
  correctedBy   User     @relation(fields: [correctedById], references: [id], onDelete: Restrict)
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  selections AnswerCorrectionSelection[]

  @@unique([reviewId, sequence])
  /// Para la FK compuesta de las selecciones.
  @@unique([id, questionId])
  @@index([answerId, questionId])
  @@index([correctedById])
  @@map("answer_corrections")
}

/// Opción elegida en una corrección de selección (tabla puente).
model AnswerCorrectionSelection {
  correctionId String           @map("correction_id")
  questionId   String           @map("question_id")
  optionId     String           @map("option_id")
  correction   AnswerCorrection @relation(fields: [correctionId, questionId], references: [id, questionId], onDelete: Restrict)
  option       AnswerOption     @relation(fields: [optionId, questionId], references: [id, questionId], onDelete: Restrict)

  @@id([correctionId, optionId])
  @@index([correctionId, questionId])
  @@index([optionId, questionId])
  @@map("answer_correction_selections")
}

/// Aprobación de una revisión, atada al cálculo aprobado. A lo sumo una
/// vigente (`voidedAt` nulo) por revisión: índice único parcial. Solo admite
/// anularse una vez; nada más cambia (trigger en la migración).
model ReviewApproval {
  id                String             @id @default(cuid())
  reviewId          String             @map("review_id")
  review            Review             @relation(fields: [reviewId], references: [id], onDelete: Restrict)
  calculationId     String             @map("calculation_id")
  calculation       Calculation        @relation(fields: [calculationId], references: [id], onDelete: Restrict)
  approvedById      String             @map("approved_by_id")
  approvedBy        User               @relation("ReviewApprovalApprovedBy", fields: [approvedById], references: [id], onDelete: Restrict)
  /// Motivo para aprobar sin un análisis de IA exitoso. Nulo si no hizo falta.
  aiExceptionReason String?            @map("ai_exception_reason") @db.VarChar(500)
  approvedAt        DateTime           @default(now()) @map("approved_at") @db.Timestamptz(3)
  voidedAt          DateTime?          @map("voided_at") @db.Timestamptz(3)
  voidCause         ApprovalVoidCause? @map("void_cause")
  /// Quién la anuló: el que reabrió o el que pidió el cálculo nuevo.
  voidedById        String?            @map("voided_by_id")
  voidedBy          User?              @relation("ReviewApprovalVoidedBy", fields: [voidedById], references: [id], onDelete: Restrict)
  /// Motivo de reabrir; obligatorio en `REOPENED` (CHECK en la migración).
  voidReason        String?            @map("void_reason") @db.VarChar(500)

  reports Report[]

  @@unique([id, reviewId])
  @@index([reviewId])
  @@index([calculationId])
  @@index([approvedById])
  @@index([voidedById])
  @@map("review_approvals")
}

/// Nota del revisor, general (`dimension` nula) o de una dimensión. La usará
/// Delivery para redactar el informe.
model ReviewNote {
  id        String   @id @default(cuid())
  reviewId  String   @map("review_id")
  review    Review   @relation(fields: [reviewId], references: [id], onDelete: Restrict)
  /// Texto libre mientras las dimensiones D1–D8 no estén confirmadas.
  dimension String?  @db.VarChar(64)
  body      String   @db.VarChar(5000)
  authorId  String   @map("author_id")
  author    User     @relation(fields: [authorId], references: [id], onDelete: Restrict)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([reviewId, createdAt])
  @@index([authorId])
  @@map("review_notes")
}

/// Estado del informe (PF-42). La entrega (`DELIVERED`) llega con el PR de
/// la entrega.
enum ReportStatus {
  DRAFT
  APPROVED

  @@map("report_status")
}

/// Parte de una sección del informe, por dimensión. Se ordena así.
enum ReportPart {
  FINDING
  IMPLICATION
  RECOMMENDATION
  NEXT_STEP

  @@map("report_part")
}

/// Quién escribió una versión de una sección.
enum ReportRevisionSource {
  /// La IA, a pedido de `authorId`; `aiCallLogId` es la llamada.
  AI
  /// Una persona (`authorId`) la editó.
  HUMAN

  @@map("report_revision_source")
}

/// Informe del diagnóstico (PF-42): uno por revisión. La IA redacta el
/// borrador a partir de una aprobación de la revisión (`reviewApprovalId`);
/// una persona lo edita y un Aprobador lo aprueba. `version` sube con cada
/// cambio (ETag/If-Match).
model Report {
  id               String         @id @default(cuid())
  reviewId         String         @unique @map("review_id")
  review           Review         @relation(fields: [reviewId], references: [id], onDelete: Restrict)
  status           ReportStatus   @default(DRAFT)
  /// La aprobación de la revisión con cuyo resultado se redactó el borrador.
  /// Si ya no es la vigente, el informe está desactualizado y no se aprueba.
  reviewApprovalId String         @map("review_approval_id")
  /// La FK compuesta garantiza que sea una aprobación de esta misma revisión.
  reviewApproval   ReviewApproval @relation(fields: [reviewApprovalId, reviewId], references: [id, reviewId], onDelete: Restrict)
  version          Int            @default(0)
  createdAt        DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)

  sections  ReportSection[]
  approvals ReportApproval[]

  @@index([reviewApprovalId, reviewId])
  @@index([status, updatedAt])
  @@map("reports")
}

/// Una parte de una dimensión del informe. El texto vive en sus versiones
/// (`ReportSectionRevision`): el vigente es el de mayor `sequence`.
model ReportSection {
  id        String     @id @default(cuid())
  reportId  String     @map("report_id")
  report    Report     @relation(fields: [reportId], references: [id], onDelete: Restrict)
  /// Código de la dimensión tal como lo devuelve el cálculo (`D1`). Pasa a un
  /// catálogo con FK cuando se confirmen D1–D8.
  dimension String     @db.VarChar(64)
  /// Orden de la dimensión en el resultado del cálculo.
  position  Int
  part      ReportPart

  revisions ReportSectionRevision[]

  @@unique([reportId, dimension, part])
  @@index([reportId, position])
  @@map("report_sections")
}

/// Historial de una sección, de solo inserción: cada cambio de la IA o de una
/// persona agrega una fila, nunca la sobrescribe.
model ReportSectionRevision {
  id          String               @id @default(cuid())
  sectionId   String               @map("section_id")
  section     ReportSection        @relation(fields: [sectionId], references: [id], onDelete: Restrict)
  /// Orden dentro de la sección (1, 2, 3...), asignado con el informe bloqueado.
  sequence    Int
  body        String               @db.VarChar(4000)
  source      ReportRevisionSource
  /// La llamada a la IA que lo redactó. Solo y siempre con `source = AI`.
  aiCallLogId String?              @map("ai_call_log_id")
  aiCallLog   AiCallLog?           @relation(fields: [aiCallLogId], references: [id], onDelete: Restrict)
  /// Quién lo editó, o quién pidió la redacción a la IA.
  authorId    String               @map("author_id")
  author      User                 @relation(fields: [authorId], references: [id], onDelete: Restrict)
  createdAt   DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)

  approvals ReportApprovalRevision[]

  @@unique([sectionId, sequence])
  @@index([aiCallLogId])
  @@index([authorId])
  @@map("report_section_revisions")
}

/// Aprobación del informe, separada de la de la revisión y atada a las
/// versiones exactas de cada sección (`ReportApprovalRevision`). Se anula si
/// se anula la aprobación de la revisión, con la misma causa.
model ReportApproval {
  id            String             @id @default(cuid())
  reportId      String             @map("report_id")
  report        Report             @relation(fields: [reportId], references: [id], onDelete: Restrict)
  /// `Report.version` al aprobar.
  reportVersion Int                @map("report_version")
  approvedById  String             @map("approved_by_id")
  approvedBy    User               @relation("ReportApprovalApprovedBy", fields: [approvedById], references: [id], onDelete: Restrict)
  approvedAt    DateTime           @default(now()) @map("approved_at") @db.Timestamptz(3)
  voidedAt      DateTime?          @map("voided_at") @db.Timestamptz(3)
  /// Por qué se anuló la aprobación de la revisión que arrastró esta.
  voidCause     ApprovalVoidCause? @map("void_cause")
  /// Quién anuló la de la revisión. Nulo si fue el sistema.
  voidedById    String?            @map("voided_by_id")
  voidedBy      User?              @relation("ReportApprovalVoidedBy", fields: [voidedById], references: [id], onDelete: Restrict)

  revisions ReportApprovalRevision[]

  @@index([reportId])
  @@index([approvedById])
  @@index([voidedById])
  @@map("report_approvals")
}

/// Qué versión de cada sección se aprobó. De solo inserción.
model ReportApprovalRevision {
  approvalId String                @map("approval_id")
  approval   ReportApproval        @relation(fields: [approvalId], references: [id], onDelete: Restrict)
  revisionId String                @map("revision_id")
  revision   ReportSectionRevision @relation(fields: [revisionId], references: [id], onDelete: Restrict)

  @@id([approvalId, revisionId])
  @@index([revisionId])
  @@map("report_approval_revisions")
}
