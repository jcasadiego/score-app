// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// Bitácora de auditoría: registra toda acción de escritura hecha a través
/// de la API (requisito duro de P4). El detalle de qué se cambió va en
/// `data`, ya que la forma exacta depende de cada entidad. La relación
/// hacia la entidad afectada es por referencia (`entity` + `entityId`),
/// no una llave foránea, para no acoplar este modelo a las tablas de cada
/// módulo que use el servicio de auditoría.
model AuditLog {
  id        String         @id @default(cuid())
  actorType AuditActorType @map("actor_type")
  actorId   String?        @map("actor_id")
  action    String
  entity    String
  entityId  String?        @map("entity_id")
  data      Json?
  /// Mismo id del encabezado `X-Request-Id` y del log: une los tres al
  /// investigar un incidente. Nulo en eventos sin petición HTTP.
  requestId String?        @map("request_id")
  createdAt DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([entity, entityId])
  @@index([createdAt])
  @@index([requestId])
  @@map("audit_logs")
}

/// Versión de reglas aplicada a un diagnóstico (requisito duro de P4).
/// El contenido de las reglas es configuración, no código — vive en
/// `content` mientras se define la especificación completa del
/// cuestionario y su lógica.
model RuleSetVersion {
  id        String   @id @default(cuid())
  number    Int      @unique @default(autoincrement())
  content   Json
  active    Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@map("rule_set_versions")
}

/// Matriz de permisos en CLAUDE.md, sección 5.3.
enum UserRole {
  /// Aprobador: puede hacer todo.
  ADMIN
  /// Revisor.
  REVIEWER

  @@map("user_role")
}

/// Tipo de actor que ejecuta una acción auditada: usuario autenticado de
/// `apps/panel`, cliente final de `apps/diagnostico` (vía token de
/// enlace), o el propio sistema cuando no hay actor autenticado (ej. antes
/// de un login).
enum AuditActorType {
  PANEL_USER
  END_CLIENT
  SYSTEM

  @@map("audit_actor_type")
}

/// Placeholder de autenticación para apps/panel. TODO: el modelo real de
/// permisos (roles múltiples, alcance por caso, etc.) es un pendiente
/// explícito del proyecto — este modelo solo existe para que el
/// mecanismo de login JWT tenga contra qué autenticar mientras tanto.
model User {
  id                  String    @id @default(cuid())
  name                String
  email               String    @unique
  passwordHash        String    @map("password_hash")
  /// Nulo mientras la cuenta espera que su dueño defina la contraseña con el
  /// enlace del correo: al crearla o cuando un Aprobador la invalida. Mientras
  /// tanto `passwordHash` es de una contraseña aleatoria que nadie conoce.
  passwordSetAt       DateTime? @default(now()) @map("password_set_at") @db.Timestamptz(3)
  active              Boolean   @default(true)
  /// Sin valor por defecto: el rol siempre se elige de forma explícita.
  role                UserRole
  /// Va en el JWT (`ver`); subirla invalida todas las sesiones abiertas
  /// del usuario. Se sube en cada cambio de contraseña.
  sessionVersion      Int       @default(0) @map("session_version")
  /// Contraseñas incorrectas seguidas. Se reinicia al entrar o al bloquear.
  failedLoginAttempts Int       @default(0) @map("failed_login_attempts")
  /// Hasta cuándo se rechaza el login, aunque la contraseña sea correcta.
  lockedUntil         DateTime? @map("locked_until") @db.Timestamptz(3)
  /// Secreto TOTP cifrado con `MFA_ENCRYPTION_KEY`. Solo sale en una respuesta
  /// una vez, al configurarlo.
  mfaSecret           String?   @map("mfa_secret")
  /// Nulo mientras no se confirme el primer código: el secreto aún no vale.
  mfaEnabledAt        DateTime? @map("mfa_enabled_at") @db.Timestamptz(3)
  /// Último intervalo de 30 s usado: un mismo código no sirve dos veces.
  mfaLastUsedStep     Int?      @map("mfa_last_used_step")
  createdAt           DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  passwordResetTokens PasswordResetToken[]
  sessions            UserSession[]
  recoveryCodes       UserRecoveryCode[]

  createdQuestionnaireVersions   QuestionnaireVersion[] @relation("QuestionnaireVersionCreatedBy")
  publishedQuestionnaireVersions QuestionnaireVersion[] @relation("QuestionnaireVersionPublishedBy")

  @@map("users")
}

/// Sesión abierta del panel. El JWT la nombra en `sid`: mientras exista la
/// fila el token vale, y cerrar la sesión la borra. Una por usuario (un solo
/// dispositivo): `userId` único lo garantiza también ante logins simultáneos.
/// `expiresAt` es el límite absoluto de la sesión.
model UserSession {
  id        String   @id @default(cuid())
  userId    String   @unique @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime @map("expires_at") @db.Timestamptz(3)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@map("user_sessions")
}

/// Código de un solo uso para entrar sin el autenticador. Se guarda solo el
/// SHA-256: es aleatorio de 80 bits, así que no hace falta un hash lento.
model UserRecoveryCode {
  id        String    @id @default(cuid())
  userId    String    @map("user_id")
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  codeHash  String    @unique @map("code_hash")
  usedAt    DateTime? @map("used_at") @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([userId])
  @@map("user_recovery_codes")
}

/// Enlace de recuperación de contraseña del panel: un solo uso, vence en
/// una hora. Se guarda solo el SHA-256 del token, nunca el token.
model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String    @map("user_id")
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(3)
  usedAt    DateTime? @map("used_at") @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([userId])
  @@map("password_reset_tokens")
}

/// Familia de diagnóstico que el cliente elige en el formulario de
/// precalificación de `score-sitio`. La API no la infiere: llega ya
/// elegida en el payload.
enum DiagnosticFamily {
  PROJECT
  B2B
  PROFESSIONAL
  CATALOG

  @@map("diagnostic_family")
}

/// Estado comercial de un lead, que el equipo cambia a mano desde el panel
/// mientras no hay CRM. Los estados de pago y diagnóstico activado los
/// agrega el módulo de Pagos.
enum LeadStatus {
  NEW
  CONTACTED
  CONVERTED

  @@map("lead_status")
}

/// Lead registrado desde el formulario de precalificación de
/// `score-sitio` (único punto de contacto entre los dos repos, ver
/// CLAUDE.md sección 7). `email` no es único a propósito: la misma
/// persona puede precalificar más de una vez.
model Lead {
  id          String           @id @default(cuid())
  name        String
  email       String
  phone       String?
  family      DiagnosticFamily
  utmSource   String?          @map("utm_source")
  utmMedium   String?          @map("utm_medium")
  utmCampaign String?          @map("utm_campaign")
  status      LeadStatus       @default(NEW)
  createdAt   DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([email])
  @@index([createdAt])
  @@map("leads")
}

enum QuestionnaireVersionStatus {
  /// Editable. A lo sumo uno por familia (índice parcial en la migración).
  DRAFT
  /// Inmutable: un trigger rechaza cualquier cambio a la versión, sus
  /// preguntas y sus opciones.
  PUBLISHED

  @@map("questionnaire_version_status")
}

enum QuestionType {
  SINGLE_CHOICE
  MULTIPLE_CHOICE
  FREE_TEXT

  @@map("question_type")
}

/// Versión del cuestionario de una familia. Cada diagnóstico apunta a la versión
/// publicada que respondió, sin copiar sus preguntas (PF-16).
model QuestionnaireVersion {
  id            String                     @id @default(cuid())
  family        DiagnosticFamily
  versionNumber Int                        @map("version_number")
  status        QuestionnaireVersionStatus @default(DRAFT)
  /// Contenido de prueba mientras llega el cuestionario oficial. Nunca existe en
  /// producción (lo carga `prisma/sample-questionnaire.ts`), y un borrador nuevo
  /// no copia sus preguntas.
  isSample      Boolean                    @default(false) @map("is_sample")
  createdById   String                     @map("created_by_id")
  createdBy     User                       @relation("QuestionnaireVersionCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  publishedAt   DateTime?                  @map("published_at") @db.Timestamptz(3)
  publishedById String?                    @map("published_by_id")
  publishedBy   User?                      @relation("QuestionnaireVersionPublishedBy", fields: [publishedById], references: [id], onDelete: Restrict)
  createdAt     DateTime                   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime                   @updatedAt @map("updated_at") @db.Timestamptz(3)

  questions Question[]

  @@unique([family, versionNumber])
  @@index([createdById])
  @@index([publishedById])
  @@map("questionnaire_versions")
}

/// Pregunta de una versión. `code` es estable entre versiones: identifica la
/// misma pregunta aunque cambie su texto.
model Question {
  id                     String               @id @default(cuid())
  questionnaireVersionId String               @map("questionnaire_version_id")
  /// Borrar una versión no está permitido; borrar una pregunta de un borrador
  /// arrastra sus opciones.
  questionnaireVersion   QuestionnaireVersion @relation(fields: [questionnaireVersionId], references: [id], onDelete: Restrict)
  code                   String               @db.VarChar(64)
  text                   String               @db.VarChar(500)
  type                   QuestionType
  helpText               String?              @map("help_text") @db.VarChar(1000)
  required               Boolean
  /// Solo en `FREE_TEXT`, y ahí obligatorio (CHECK en la migración).
  maxLength              Int?                 @map("max_length")
  position               Int

  options AnswerOption[]

  @@unique([questionnaireVersionId, code])
  @@map("questions")
}

/// Opción de una pregunta de selección. `value` es estable entre versiones.
model AnswerOption {
  id         String   @id @default(cuid())
  questionId String   @map("question_id")
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  text       String   @db.VarChar(300)
  value      String   @db.VarChar(64)
  position   Int

  @@unique([questionId, value])
  /// Para la FK compuesta de las respuestas (PF-16): una respuesta solo puede
  /// elegir opciones de su propia pregunta.
  @@unique([id, questionId])
  @@map("answer_options")
}
