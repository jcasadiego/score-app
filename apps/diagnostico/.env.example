# La API sirve las rutas de dominio bajo /api/v1 (ver api/src/bootstrap.ts):
# este valor es solo el host, sin el prefijo. La app la llama solo desde su
# servidor; el navegador nunca habla con la API.
NEXT_PUBLIC_API_URL="http://localhost:3000"

# Mismo valor que DIAGNOSTIC_API_SECRET en api, distinto del del panel: permite
# informar la IP real del cliente al canjear o recuperar su enlace. Solo del
# servidor: nunca con prefijo NEXT_PUBLIC_. Vacío en desarrollo; obligatorio
# en producción.
DIAGNOSTIC_API_SECRET=""
