# La API ahora sirve las rutas de dominio bajo /api/v1 (ver
# api/src/bootstrap.ts) — este valor es solo el host, sin el prefijo.
NEXT_PUBLIC_API_URL="http://localhost:3000"

# Mismo valor que en api: permite informar la IP real de quien inicia sesión.
# Solo del servidor: nunca con prefijo NEXT_PUBLIC_. Vacío en desarrollo;
# obligatorio en producción.
PANEL_API_SECRET=""

# Proxies delante de este servidor: la IP del cliente es la entrada que está
# esas posiciones desde el final de `x-forwarded-for`. Igual que en la API.
# Render QA: 3 (medido en PF-69). Vacío en local (sin proxy) = 1.
TRUST_PROXY_HOPS=""

# Encabezado con la IP del cliente que pone la plataforma y el cliente no puede
# falsificar. Si está, manda sobre TRUST_PROXY_HOPS. Render: cf-connecting-ip
# (Cloudflare lo sobrescribe). Vacío en local.
CLIENT_IP_HEADER=""

# Commit desplegado (PF-71). Lo pone Render, no se carga a mano: el workflow
# de despliegue lo usa para confirmar que la versión nueva está arriba. Sin
# ella (local), /health devuelve `commit: null` y Next.js usa su id de build.
# RENDER_GIT_COMMIT=""
